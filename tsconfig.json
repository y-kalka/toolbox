{
	"compilerOptions": {
		"target": "es2020",
		"lib": ["ES2020", "DOM"],
		"module": "NodeNext",
		"moduleDetection": "force",
		"moduleResolution": "NodeNext",
		"declaration": true,
		"outDir": "./dist",
		"forceConsistentCasingInFileNames": true,
		"noImplicitAny": true,
		"erasableSyntaxOnly": true,
		"strict": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"noUncheckedIndexedAccess": true
	},
	"include": ["src"],
	"exclude": ["dist", "node_modules", "**/*.test.ts"]
}
